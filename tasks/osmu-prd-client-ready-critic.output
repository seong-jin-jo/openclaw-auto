from pathlib import Path
import re
p=Path('docs/openclaw-auto-osmu-prd-v2.1-gpt-codex.md')
s=p.read_text()
# TOC href anchors
hrefs=re.findall(r'\\]\\(#(["'^)]+)'"\\)', s)
ids=set(re.findall(r'<a id=\"(["'^"]+)"></a>'"',s))
print('toc_hrefs',len(hrefs),'unique',len(set(hrefs)),'missing',sorted(set(hrefs)-ids))
# Row IDs and counts
rows=[]
for line in s.splitlines():
    m=re.match(r'\\| (L-\\d\\d|N-\\d\\d|B-\\d\\d) \\|',line)
    if m: rows.append(m.group(1))
print('req_rows',len(rows),'unique',len(set(rows)))
# Mermaid blocks
blocks=re.findall(r'"'```mermaid'"\\n(.*?)"'```'"',s,re.S)
print('mermaid_blocks',len(blocks),'flowchart',sum(b.lstrip().startswith('flowchart') for b in blocks))
# GWT counts in req rows
for line in s.splitlines():
    if re.match(r'\\| (L-\\d\\d|N-\\d\\d|B-\\d\\d) \\|',line):
        rid=line.split('|')[1].strip()
        print(rid, 'Given',line.count('**Given**'),'When',line.count('**When**'),'Then',line.count('**Then**'),'and',line.count('과 ')+line.count('와 ')+line.count('·'))
