/bin/zsh -lc "ruby - docs/openclaw-auto-osmu-prd-v2.1-gpt-codex.md > /tmp/osmu-prd-v2.1-validation.log 2>&1 <<'RUBY'
path = ARGV.fetch(0)
text = File.read(path)
checks = []
check = ->(name, ok, detail='') { checks << [name, "'!!ok, detail] }

toc = text.scan(/'"\\]\\(#(["'^)]+)'"\\)/).flatten
anchors = text.scan(/<a id=\"(["'^"]+)"><'"\\/a>/).flatten
check.call('toc_anchor_bijection', toc.sort == anchors.sort && toc.uniq.size == toc.size, \"toc=#{toc.size}, anchors=#{anchors.size}\")

links = text.scan(/\\]\\((<["'^>]+>|[''^)]+)'"\\)/).flatten.map { |x| x.sub(/\\A</,'').sub(/>\\z/,'') }
internal = links.reject { |x| x.start_with?('http://', 'https://', '#') }
broken = internal.uniq.reject { |x| File.exist?(x.start_with?('/') ? x : File.expand_path(x, File.dirname(path))) }
check.call('internal_links_exist', broken.empty?, \"internal=#{internal.uniq.size}, broken=#{broken.inspect}\")

persona = text[/### 6\\.1 핵심 페르소나.*?\\n\\n(.*?)\\n\\n\\*\\*Pain 한 줄:/m, 1].to_s.gsub(/\\s+/, '')
check.call('persona_600_chars', persona.length >= 600, \"chars_no_space=#{persona.length}\")

obs = text.lines.grep(/"'^'"\\| O-\\d{2} \\|/)
check.call('observations_7', obs.size == 7, \"count=#{obs.size}\")

rows = text.lines.grep(/"'^'"\\| [LNB]-\\d{2} \\|/)
ids = rows.map { |line| line.split('|')[1].strip }
expected_ids = (1..13).map { |n| format('L-%02d', n) } + (1..9).map { |n| format('N-%02d', n) } + (1..7).map { |n| format('B-%02d', n) }
check.call('requirements_exact_29', ids.sort == expected_ids.sort && ids.uniq.size == 29, \"rows=#{rows.size}, unique=#{ids.uniq.size}\")

bad_columns = []
bad_ac = []
bad_tc = []
releases = Hash.new(0)
tcs = []
rows.each do |line|
  cells = line.split('|', -1)[1...-1].map(&:strip)
  id = cells[0]
  bad_columns << id unless cells.size == 7 && cells.all? { |c| "'!c.empty? }
  releases[cells[1]] += 1
  ac = cells[5].to_s
  bad_ac << id unless ['"'Given', 'When', 'Then'].all? { |word| ac.scan(\"**#{word}**\").size == 1 }
  tc = cells[6].to_s[/TC-[LNB]\\d{2}/]
  tcs << tc
  bad_tc << id unless tc == \"TC-#{id.delete('-')}\"
end
check.call('requirement_columns_complete', bad_columns.empty?, \"bad=#{bad_columns.inspect}\")
check.call('atomic_gwt_1_each', bad_ac.empty?, \"bad=#{bad_ac.inspect}\")
check.call('tc_id_1_to_1', bad_tc.empty? && tcs.compact.uniq.size == 29, \"bad=#{bad_tc.inspect}, unique=#{tcs.compact.uniq.size}\")
check.call('release_counts', releases == {'R0'=>15, 'R1'=>5, 'R2'=>7, 'Backlog'=>2}, releases.inspect)

mermaid = text[/"'```mermaid'"\\n(.*?)\\n"'```/m, 1]
check.call('"'mermaid_single_closed_block', "'!mermaid.nil? && text.scan(/''^```mermaid$/).size == 1, "blocks=#{text.scan(/''^```mermaid$/).size}")
if mermaid
  lines = mermaid.lines.map(&:strip).reject(&:empty?)
  check.call('"'mermaid_direction', lines.shift == 'flowchart TD')
  edge_re = /\\A([A-Z])(?:\\[["'^'"\\]]+\\]|\\{["'^}]+'"\\})?(?: -- ["'^-]+)? --> ([A-Z])(?:'"\\[["'^'"\\]]+\\]|\\{["'^}]+'"\\})?\\z/
  parsed = lines.map { |line| [line, edge_re.match(line)] }
  check.call('mermaid_edge_syntax', parsed.all? { |_, m| m }, \"bad=#{parsed.reject { |_,m| m }.map(&:first).inspect}\")
  defs = mermaid.scan(/\\b([A-Z])(?:\\[["'^'"\\]]+\\]|\\{["'^}]+'"\\})/).flatten.uniq
  refs = parsed.filter_map { |_, m| m && [m[1], m[2]] }.flatten.uniq
  check.call('mermaid_nodes_defined', (refs - defs).empty?, \"defined=#{defs.size}, refs=#{refs.size}, missing=#{(refs-defs).inspect}\")
end

check.call('benchmark_doc_sources_3plus', ['Kubernetes KEP Template','GitLab Product Development Flow','Go Change Proposal Process'].all? { |s| text.include?(s) })
check.call('benchmark_product_five', ['Buffer','Postiz','Jasper','Meta 공식','GitHub'].all? { |s| text.include?(s) })
check.call('required_footers', ['SKILLS_USED:','SKILLS_SKIPPED:','SOURCES','MODEL:','RUBRIC_SCORE:','WEAKEST_LINE:'].all? { |s| text.include?(s) })
check.call('no_toolcall_residue', "'!text.match?(%r{</?(content|invoke)>|TODO|TBD|PLACEHOLDER}i))

checks.each { |name, ok, detail| puts "#{ok ? '"'PASS' : 'FAIL'} #{name} #{detail}\".rstrip }
failed = checks.reject { |_, ok, _| ok }
puts \"SUMMARY pass=#{checks.size-failed.size} fail=#{failed.size}\"
exit(failed.empty? ? 0 : 1)
RUBY
osmu_validator_exit="'$?
tail -n 40 /tmp/osmu-prd-v2.1-validation.log
exit $osmu_validator_exit' in /Users/sj/sj_code_master/openclaw-auto
 exited 1 in 99ms:
