{
  "display_name": "Seedream 5.0 Pro",
  "job_type": "seedream_v5_pro",
  "params": [
    {
      "name": "aspect_ratio",
      "type": "string",
      "default": "1:1",
      "required": false,
      "enum": [
        "1:1",
        "4:3",
        "3:4",
        "16:9",
        "9:16",
        "3:2",
        "2:3",
        "21:9"
      ]
    },
    {
      "name": "height",
      "type": "integer|null",
      "default": null,
      "required": false
    },
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "is_inpaint",
      "type": "boolean",
      "default": false,
      "required": false
    },
    {
      "name": "prompt",
      "type": "string",
      "default": null,
      "required": true
    },
    {
      "name": "remove_bg",
      "type": "boolean",
      "default": false,
      "required": false
    },
    {
      "name": "resolution",
      "type": "string",
      "default": "2k",
      "required": false,
      "enum": [
        "1k",
        "1.5k",
        "2k"
      ]
    },
    {
      "name": "width",
      "type": "integer|null",
      "default": null,
      "required": false
    }
  ],
  "rules": [
    {
      "cel": "size(params.image_references) <= 10",
      "message": "at most 10 image_references are allowed"
    }
  ],
  "type": "image"
}
