{
  "display_name": "FLUX 3 Video",
  "job_type": "flux_3_video",
  "params": [
    {
      "name": "aspect_ratio",
      "type": "string",
      "default": "auto",
      "required": false,
      "enum": [
        "auto",
        "21:9",
        "2:1",
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16"
      ]
    },
    {
      "name": "duration",
      "type": "integer",
      "default": 5,
      "required": false
    },
    {
      "name": "end_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "generate_audio",
      "type": "boolean",
      "default": true,
      "required": false
    },
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "prompt",
      "type": "string",
      "default": null,
      "required": true
    },
    {
      "name": "resolution",
      "type": "string",
      "default": "720p",
      "required": false,
      "enum": [
        "720p",
        "1080p"
      ]
    },
    {
      "name": "start_image",
      "type": "object|null",
      "default": null,
      "required": false
    },
    {
      "name": "video_references",
      "type": "array",
      "default": null,
      "required": false
    }
  ],
  "rules": [
    {
      "cel": "size(params.image_references) + (params.start_image == null ? 0 : 1) + (params.end_image == null ? 0 : 1) <= 10",
      "message": "at most 10 images are allowed across start_image, image_references, and end_image"
    },
    {
      "cel": "size(params.video_references) == 0 || (size(params.image_references) == 0 && params.start_image == null && params.end_image == null)",
      "message": "image inputs and video_references cannot be mixed"
    },
    {
      "cel": "params.end_image == null || !(params.start_image == null)",
      "message": "end_image requires start_image"
    }
  ],
  "type": "video"
}
